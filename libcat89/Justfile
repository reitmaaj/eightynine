CC := env_var_or_default("CC", "cc")
GREEN := env_var_or_default("GREEN", "../../green/.agent/tmp/build/green")
STRICT := "-std=c89 -pedantic-errors -Wall -Wextra -Werror -Wconversion -Wsign-conversion -Wstrict-prototypes -Wmissing-prototypes -Wold-style-definition -Wundef -Wshadow -Wformat=2"

# Public headers and sources. libcat89 is self-contained (no sibling deps).
# Every translation unit under src/ is compiled into the archive.

# Compile every library translation unit and archive build/libcat89.a.
build:
	mkdir -p build
	@for f in src/*.c; do \
	    name=$(basename "$f" .c); \
	    {{CC}} {{STRICT}} -Iinclude -Isrc -c "$f" -o "build/$name.o" || exit 1; \
	done
	rm -f build/libcat89.a
	@objs=""; for f in src/*.c; do \
	    name=$(basename "$f" .c); \
	    objs="$objs build/$name.o"; \
	done; \
	ar rcs build/libcat89.a $objs

# Compile shared test fixtures into a small archive (mock/finite categories).
fixtures: build
	mkdir -p build
	@for f in test/fixtures/*.c; do \
	    [ -e "$f" ] || continue; \
	    name=fix_$(basename "$f" .c); \
	    {{CC}} {{STRICT}} -Wno-unused-function -Iinclude -Isrc -Itest/fixtures -c "$f" -o "build/$name.o" || exit 1; \
	done
	rm -f build/libcat89-fixtures.a
	ar rcs build/libcat89-fixtures.a build/fix_*.o

# Compile-only gate: each public header must compile standalone in strict C89.
headers: build
	@for h in include/cat89/*.h; do \
	    printf 'headers: %s\n' "$h"; \
	    {{CC}} {{STRICT}} -Iinclude -x c -include "$h" -c /dev/null -o /dev/null; \
	done

# Smoke test first: one end-to-end path through the library.
smoke: fixtures
	{{CC}} {{STRICT}} -Wno-unused-function -Iinclude -Itest -Itest/fixtures -o build/smoke \
	    test/smoke.c build/libcat89.a build/libcat89-fixtures.a
	./build/smoke

# Unit tests, one small program per concern.
unit: fixtures
	@for t in test/unit/test_*.c; do \
	    [ -e "$t" ] || continue; \
	    name=$(basename "$t" .c); \
	    {{CC}} {{STRICT}} -Wno-unused-function -Iinclude -Isrc -Itest -Itest/unit -Itest/fixtures \
	        -o "build/$name" "$t" build/libcat89-fixtures.a build/libcat89.a || exit 1; \
	    ./build/$name || exit 1; \
	done

# Run every test (smoke runs first, then the unit suite).
test: smoke unit

# Generate the GCC and Clang compilation databases, then run the green matrix.
green:
	sh scripts/gen_compile_db gcc build/gcc/compile_commands.json
	sh scripts/gen_compile_db clang build/clang/compile_commands.json
	{{GREEN}} check

# Green-compliance gate (the seven-cell matrix).
check: green

# Strict C89 portability baseline over all sources and headers.
baseline:
	make -f c89-baseline.mk check EXTRA="-Iinclude -Isrc -Itest -Itest/unit -Itest/fixtures"

# Lint shell scripts and check C/header formatting.
lint:
	@for f in scripts/*.sh test/*.sh; do \
	    [ -e "$f" ] || continue; \
	    shellcheck -s sh "$f" || exit 1; \
	    shellcheck -s bash "$f" || exit 1; \
	done
	@for f in src/*.c src/*.h include/cat89/*.h test/*.c test/unit/*.c test/fixtures/*.c test/*.h; do \
	    [ -e "$f" ] || continue; \
	    clang-format --dry-run --Werror "$f" || { echo "needs formatting: $f"; exit 1; }; \
	done
	sh scripts/check_arch.sh

# ABI / architecture hygiene gates (core isolation, header-DAG, symbol surface).
arch: build
	sh scripts/check_arch.sh

# Rewrite sources to canonical formatting.
format:
	@for f in src/*.c src/*.h include/cat89/*.h test/*.c test/unit/*.c test/fixtures/*.c test/*.h; do \
	    [ -e "$f" ] || continue; \
	    clang-format -i "$f"; \
	done

# Verify required external tools are available.
doctor:
	@command -v gcc >/dev/null 2>&1 || { echo "missing: gcc"; exit 1; }
	@command -v clang >/dev/null 2>&1 || { echo "missing: clang"; exit 1; }
	@command -v clang-tidy >/dev/null 2>&1 || { echo "missing: clang-tidy"; exit 1; }
	@command -v clang-format >/dev/null 2>&1 || { echo "missing: clang-format"; exit 1; }
	@command -v just >/dev/null 2>&1 || { echo "missing: just"; exit 1; }
	@echo "doctor: all prerequisites present"

# Build and run the whole suite under ASan + UBSan + LSan (fail on any issue).
sanitize:
	mkdir -p build-san
	@for f in src/*.c; do \
	    name=$(basename "$f" .c); \
	    {{CC}} {{STRICT}} -fsanitize=address,undefined -fno-omit-frame-pointer -g -Iinclude -Isrc -c "$f" -o "build-san/$name.o" || exit 1; \
	done
	rm -f build-san/libcat89.a
	@objs=""; for f in src/*.c; do \
	    name=$(basename "$f" .c); \
	    objs="$objs build-san/$name.o"; \
	done; \
	ar rcs build-san/libcat89.a $objs
	@for f in test/fixtures/*.c; do \
	    [ -e "$f" ] || continue; \
	    name=fix_$(basename "$f" .c); \
	    {{CC}} {{STRICT}} -Wno-unused-function -fsanitize=address,undefined -fno-omit-frame-pointer -g -Iinclude -Isrc -Itest/fixtures -c "$f" -o "build-san/$name.o" || exit 1; \
	done
	rm -f build-san/libcat89-fixtures.a
	ar rcs build-san/libcat89-fixtures.a build-san/fix_*.o
	@for t in test/unit/test_*.c; do \
	    [ -e "$t" ] || continue; \
	    name=$(basename "$t" .c); \
	    {{CC}} {{STRICT}} -Wno-unused-function -fsanitize=address,undefined -fno-omit-frame-pointer -g -Iinclude -Isrc -Itest -Itest/unit -Itest/fixtures \
	        -o "build-san/$name" "$t" build-san/libcat89-fixtures.a build-san/libcat89.a || exit 1; \
	    ASAN_OPTIONS=detect_leaks=1 ./build-san/$name || exit 1; \
	done
	@{{CC}} {{STRICT}} -Wno-unused-function -fsanitize=address,undefined -fno-omit-frame-pointer -g -Iinclude -Isrc -Itest -Itest/fixtures \
	    -o build-san/smoke test/smoke.c build-san/libcat89-fixtures.a build-san/libcat89.a
	ASAN_OPTIONS=detect_leaks=1 ./build-san/smoke

# Clean both build trees.
clean:
	rm -rf build build-san
