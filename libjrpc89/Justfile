set shell := ["sh", "-eu", "-c"]

CC := env_var_or_default("CC", "cc")
LIBJ89 := env_var_or_default("LIBJ89", "../libj89")
U89 := env_var_or_default("U89", LIBJ89 + "/../libu89")
U89LIB := U89 + "/build/libu89.a"
STR89 := env_var_or_default("STR89", LIBJ89 + "/../libstr89")
STR89INC := STR89 + "/include"
STR89LIB := STR89 + "/build/libstr89.a"
GREEN := env_var_or_default("GREEN", "../../green/.agent/tmp/build/green")

STRICT := "-std=c89 -pedantic-errors -Wall -Wextra -Werror -Wconversion -Wsign-conversion -Wstrict-prototypes -Wmissing-prototypes -Wold-style-definition -Wundef -Wshadow -Wformat=2"

SRC := "src/jrpc89_internal.c src/id.c src/request.c src/response.c src/error.c src/io.c src/io_posix.c"
TOOL := "tool/jrpc89.c"
LIB := "src/jrpc89_internal.c src/id.c src/request.c src/response.c src/error.c src/io.c src/io_posix.c"
LIB_NO_POSIX := "src/jrpc89_internal.c src/id.c src/request.c src/response.c src/error.c src/io.c"
LIBJ89LIB := LIBJ89 + "/build/libj89.a"

default: build

# Build the sibling dependencies: libstr89 (owned UTF-8 storage for libj89,
# which builds libu89 first) and libj89's static archive.
deps:
	cd {{STR89}} && just build
	cd {{LIBJ89}} && just lib

# Compile the CLI demo (tool + library + libj89 archive).
build: deps
	mkdir -p build
	{{CC}} {{STRICT}} -Iinclude -I{{LIBJ89}}/include -I{{U89}}/include -I{{STR89INC}} -o build/jrpc89 {{TOOL}} {{SRC}} {{LIBJ89LIB}} {{STR89LIB}} {{U89LIB}} -lm

# Static archive of the library for downstream consumers.
lib: deps
	mkdir -p build/lib
	@for f in {{LIB}}; do \
	    o=build/lib/$(basename "$f" .c).o; \
	    {{CC}} {{STRICT}} -Iinclude -I{{LIBJ89}}/include -I{{U89}}/include -I{{STR89INC}} -c "$f" -o "$o" || exit 1; \
	done
	ar rcs build/libjrpc89.a build/lib/*.o

# Unit tests, each linked with the library sources (real POSIX adapter).
unit: build
	@for t in test/unit/test_*.c; do \
	    [ -e "$t" ] || continue; \
	    name=$(basename "$t" .c); \
	    {{CC}} {{STRICT}} -Iinclude -I{{LIBJ89}}/include -I{{U89}}/include -I{{STR89INC}} -Itest/unit -o build/$name "$t" {{LIB}} {{LIBJ89LIB}} {{STR89LIB}} {{U89LIB}} -lm || exit 1; \
	    ./build/$name || exit 1; \
	done

# Framing tests against a scripted syscall seam (no POSIX adapter linked).
fault: build
	@for t in test/fault/test_*.c; do \
	    [ -e "$t" ] || continue; \
	    name=$(basename "$t" .c); \
	    {{CC}} {{STRICT}} -Iinclude -Isrc -I{{LIBJ89}}/include -I{{U89}}/include -I{{STR89INC}} -Itest/fault -o build/$name "$t" {{LIB_NO_POSIX}} {{LIBJ89LIB}} {{STR89LIB}} {{U89LIB}} -lm || exit 1; \
	    ./build/$name || exit 1; \
	done

# Allocation-failure sweep for the protocol-core builders (GNU ld wrapping).
fault-alloc: build
	{{CC}} {{STRICT}} -Iinclude -Isrc -I{{LIBJ89}}/include -I{{U89}}/include -I{{STR89INC}} -Itest/fault -o build/alloc_main test/fault/alloc_main.c test/fault/alloc_shim.c {{LIB}} {{LIBJ89LIB}} {{STR89LIB}} {{U89LIB}} -lm -Wl,--wrap=malloc -Wl,--wrap=calloc -Wl,--wrap=realloc
	./build/alloc_main

# End-to-end tests against a mock Unix-socket server (small scripts).
e2e: build
	@for s in test/e2e/smoke.sh test/e2e/error.sh test/e2e/mismatch.sh test/e2e/sigpipe.sh; do \
	    sh "$s" ./build/jrpc89 || exit 1; \
	done

# Parameterized e2e exchange suite: >=100 passing and >=100 failing cases.
e2e-suite: build
	sh test/e2e/suite.sh ./build/jrpc89

# Smoke test first: single end-to-end request/response over a Unix socket.
smoke: build
	sh test/e2e/smoke.sh ./build/jrpc89

# Run every test (smoke runs first, then unit and fault, then e2e).
test: smoke unit fault fault-alloc e2e e2e-suite

# Generate the GCC and Clang compilation databases, then run the seven-cell
# green matrix from this project root.
green:
	sh scripts/gen_compile_db gcc build/gcc/compile_commands.json
	sh scripts/gen_compile_db clang build/clang/compile_commands.json
	cd . && {{GREEN}} check

# green-compliance gate: the seven-cell matrix (C89/C23 x gcc/clang),
# clang-tidy semantic suite, and canonical format.
check: green

# ASan + UBSan build of the library and tests (clang runtime; not C89).
sanitize: deps
	mkdir -p build/asan
	@for t in test/unit/test_*.c; do \
	    [ -e "$t" ] || continue; \
	    name=$(basename "$t" .c); \
	    clang -std=c99 -fsanitize=address,undefined -fno-omit-frame-pointer -g \
	        -Iinclude -I{{LIBJ89}}/include -I{{U89}}/include -I{{STR89INC}} -Itest/unit \
	        -o "build/asan/$name" "$t" {{LIB}} {{LIBJ89LIB}} {{STR89LIB}} {{U89LIB}} -lm || exit 1; \
	    ASAN_OPTIONS=detect_leaks=1 "build/asan/$name" || exit 1; \
	done
	@for t in test/fault/test_*.c; do \
	    [ -e "$t" ] || continue; \
	    name=$(basename "$t" .c); \
	    clang -std=c99 -fsanitize=address,undefined -fno-omit-frame-pointer -g \
	        -Iinclude -Isrc -I{{LIBJ89}}/include -I{{U89}}/include -I{{STR89INC}} -Itest/fault \
	        -o "build/asan/$name" "$t" {{LIB_NO_POSIX}} {{LIBJ89LIB}} {{STR89LIB}} {{U89LIB}} -lm || exit 1; \
	    ASAN_OPTIONS=detect_leaks=1 "build/asan/$name" || exit 1; \
	done
	clang -std=c99 -fsanitize=address,undefined -fno-omit-frame-pointer -g \
	    -Iinclude -Isrc -I{{LIBJ89}}/include -I{{U89}}/include -I{{STR89INC}} -Itest/fault \
	    -o build/asan/alloc_main test/fault/alloc_main.c test/fault/alloc_shim.c \
	    {{LIB}} {{LIBJ89LIB}} {{STR89LIB}} {{U89LIB}} -lm \
	    -Wl,--wrap=malloc -Wl,--wrap=calloc -Wl,--wrap=realloc || exit 1
	ASAN_OPTIONS=detect_leaks=1 build/asan/alloc_main

# Full local gate: tests, green conformance, and sanitizers.
ci: test check sanitize

lint:
	@for f in test/*.sh test/*/*.sh scripts/*.sh; do \
	    [ -e "$f" ] || continue; \
	    shellcheck -s sh "$f" || exit 1; \
	    shellcheck -s bash "$f" || exit 1; \
	done
	@for f in src/*.c src/*.h include/*.h tool/*.c test/*/*.c; do \
	    [ -e "$f" ] || continue; \
	    clang-format --dry-run --Werror "$f" || { echo "needs formatting: $f"; exit 1; }; \
	done

format:
	@for f in src/*.c src/*.h include/*.h tool/*.c test/*/*.c; do \
	    [ -e "$f" ] || continue; \
	    clang-format -i "$f"; \
	done

# Verify required external tools are available.
doctor:
	@command -v gcc >/dev/null 2>&1 || { echo "missing: gcc"; exit 1; }
	@command -v clang >/dev/null 2>&1 || { echo "missing: clang"; exit 1; }
	@command -v clang-tidy >/dev/null 2>&1 || { echo "missing: clang-tidy"; exit 1; }
	@command -v clang-format >/dev/null 2>&1 || { echo "missing: clang-format"; exit 1; }
	@command -v shellcheck >/dev/null 2>&1 || { echo "missing: shellcheck"; exit 1; }
	@command -v python3 >/dev/null 2>&1 || { echo "missing: python3"; exit 1; }
	@echo "doctor: all prerequisites present"

clean:
	rm -rf build
