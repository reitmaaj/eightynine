# Convenience Makefile delegating to just.
# Build/test/green/check recipes live in the Justfile (just build/test/green).

.PHONY: all build test green check lint format doctor clean

all: build

build:
	just build

test:
	just test

green:
	just green

check:
	just check

lint:
	just lint

format:
	just format

doctor:
	just doctor

clean:
	just clean
